#include "philo.h"

int	get_stop(t_data *data)
{
	int	value;

	pthread_mutex_lock(&data->m_stop);
	value = data->stop;
	pthread_mutex_unlock(&data->m_stop);
	return (value);
}

void	set_stop(t_data *data, int v)
{
	pthread_mutex_lock(&data->m_stop);
	data->stop = v;
	pthread_mutex_unlock(&data->m_stop);
}
