#include "philo.h"

long	get_time(void)
{
	struct timeval	t;
	
	gettimeofday(&t, NULL);
    return ((t.tv_sec * 1000) + (t.tv_usec / 1000));
}

long	elapsed_time(t_data *data)
{
	return (get_time() - data->timers.start);
