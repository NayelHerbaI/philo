#ifndef PHILO_H
# define PHILO_H

# include <stdio.h>
# include <stdlib.h>
# include <pthread.h>
# include <unistd.h>
# include <sys/time.h>

typedef struct s_timers
{
	long	start;
}	t_timers;

typedef struct s_init
{
	int	alloc_forks;
	int	init_forks;
	int m_stop;
	int m_print;
}	t_init;

typedef struct s_data
{
	long			nb_philo;
	long			t_to_die;
	long			t_to_eat;
	long			t_to_sleep;
	long			nb_meals;
	int				stop;
	t_timers		timers;
	t_init			init;
	pthread_mutex_t	m_stop;
	pthread_mutex_t	m_print;
	pthread_mutex_t	*forks;
}	t_data;

// Utils

void	ft_putchar(char c);
int		ft_putstr(char *str, int return_value);
void	ft_putnbr(long nb);
long	ft_atoi(char *s);
int		ft_isdigits(char *s);
void	clean_everything(t_data *data);

// Time

long	get_time(void);
long	elapsed_time(t_data *data);

// Stop

void	set_stop(t_data *data, int v);
int		get_stop(t_data *data);

// Setup

int		setup(int ac, char **av, t_data *data);

